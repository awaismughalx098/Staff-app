# The staff app talks to the SAME backend as the passenger app.
# Leave unset in production: src/config.js already defaults to the deployed
# API for a production build, and to http://localhost:5000 in development.
# Set this only to point at a different backend (staging, or a self-hosted one).
VITE_API_URL=

# Optional: navigation-grade basemaps. Without it the map uses keyless layers.
VITE_MAPTILER_KEY=
